# ---------------------------------------------------------------------------
# Smart Door Security System - configuration
# Copy to .env and fill in.  NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- E-mail alerts (Gmail SMTP over SSL) ------------------------------------
# Requires 2-Step Verification + an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-pi-account@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_RECIPIENT=you@example.com
SMTP_TIMEOUT=15

# --- Access policy -----------------------------------------------------------
# Comma-separated labels (folder names in dataset/) allowed to enter
AUTHORIZED_NAMES=Akshit
# Seconds the door stays "authorized" after a recognised face
AUTH_GRACE_SECONDS=10
# Minimum seconds between two intruder e-mails
ALERT_COOLDOWN_SECONDS=30

# --- Door sensing (HC-SR04) ----------------------------------------------------
# Distance above which the door is considered open (sensor faces the door leaf)
DOOR_OPEN_THRESHOLD_CM=5
ALARM_POLL_INTERVAL=1.0

# --- Vision pipeline -----------------------------------------------------------
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
# Frames are downscaled by this factor before detection (4 => 480x270)
FRAME_SCALE=4
# Max Euclidean distance between embeddings for a match (lower = stricter)
MATCH_TOLERANCE=0.6
# 'large' = 68-point landmarks (more accurate), 'small' = 5-point (faster)
ENCODING_MODEL=large
# 'hog' (CPU-friendly) or 'cnn' (needs much more compute)
DETECTION_MODEL=hog

# --- Paths -------------------------------------------------------------------
ENCODINGS_PATH=encodings.pickle
DATASET_DIR=dataset
CAPTURE_DIR=captures

# --- GPIO (BCM numbering) --------------------------------------------------------
# Pi 5 header is gpiochip0 on kernel >= 6.6.45 (gpiochip4 on older kernels)
GPIO_CHIP=0
PIN_GREEN_LED=17
PIN_RED_LED=27
PIN_BUZZER=18
PIN_TRIG=23
PIN_ECHO=24

# --- Runtime -----------------------------------------------------------------
HEADLESS=false
