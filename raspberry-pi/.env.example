# Copy to raspberry-pi/.env and fill in. NEVER commit the real .env file.

# --- GPIO backend: auto | rpi | emulator | mock ------------------------------
HOMEAUTO_GPIO_BACKEND=auto

# --- Web API ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOMEAUTO_API_TOKEN=
# 127.0.0.1 = local only. Use 0.0.0.0 to expose on the LAN (behind a TLS reverse proxy).
HOMEAUTO_WEB_HOST=127.0.0.1
HOMEAUTO_WEB_PORT=5000
HOMEAUTO_MOTION_EMAIL=0
HOMEAUTO_DB_PATH=sensor_data.db

# --- E-mail alerts (Gmail App Password, not the account password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_RECIPIENT=
ALERT_COOLDOWN_SECONDS=300

# --- OpenWeatherMap -----------------------------------------------------------
OWM_API_KEY=

# Fallback location when IP geolocation fails (New Delhi)
DEFAULT_LAT=28.61
DEFAULT_LON=77.20

# --- Behaviour ----------------------------------------------------------------
RELAY_ACTIVE_LOW=true
BUZZER_ACTIVE_LOW=false
PROXIMITY_THRESHOLD_CM=10
MAINS_FREQUENCY_HZ=50
SENSOR_POLL_SECONDS=5

# --- Pin overrides (BCM numbering) - defaults in homeauto/config.py ---------
# PIN_LED=18
# PIN_PIR=17
# PIN_DHT11=4
# PIN_US_TRIGGER=5
# PIN_US_ECHO=6
# PIN_BUZZER=23
# PIN_LDR=26
# PIN_RELAY=19
# PIN_TM1637_CLK=21
# PIN_TM1637_DIO=20
# PIN_DIMMER_ZC=27
# PIN_DIMMER_GATE=22
